# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OFFAIR 위키 데이터 (부원 공간·댓글·업로드 기록) — 공개 저장소에 절대 올리지 않는다
/.offair-data

# 개발용 업로드 어댑터가 올린 파일 (편집기 /write · 미디어 데모)
/public/uploads/dev/
